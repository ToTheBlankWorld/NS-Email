# Local backend configuration for NS-Email.
# Copy to `.env` and adjust as needed. `.env` is git-ignored — never commit real secrets.
# Stage 0/1 read plain environment variables only (no automatic .env loading).

# Comma-separated CORS allow-list for browser clients.
NS_EMAIL_CORS_ORIGINS=http://localhost:3000

# Root directory for capture evidence, registry, and staging.
NS_EMAIL_CAPTURE_STORAGE=data/captures

# Maximum accepted capture size in bytes (absolute engine ceiling: 2 GiB).
NS_EMAIL_MAX_CAPTURE_BYTES=2147483648

# Explicit path to the tshark binary; leave empty to use tshark from PATH.
# Without tshark, captures are hashed and registered without packet metadata.
NS_EMAIL_TSHARK_PATH=
